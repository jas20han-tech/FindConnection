# =============================================================================
# GraphRAG Intelligence Platform — Environment Template
# Copy to `.env` and fill in the values you need.
# =============================================================================

# ---- Core ----
ENVIRONMENT=development
# DEMO_MODE=true runs the entire stack with an in-memory seeded graph and a
# deterministic local narrative generator. No Neo4j / OpenAI key required.
DEMO_MODE=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_V1_PREFIX=/api/v1

# ---- Frontend ----
# Leave empty to use the Next.js proxy (/api/* -> http://backend:8000).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_DEMO_MODE=true

# ---- LLM ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EXTRACTION_CONCURRENCY=25

# ---- Neo4j ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag_dev_password

# ---- PostgreSQL ----
POSTGRES_USER=graphrag
POSTGRES_PASSWORD=graphrag
POSTGRES_DB=graphrag
POSTGRES_DSN=postgresql+asyncpg://graphrag:graphrag@localhost:5432/graphrag

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- ChromaDB ----
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_CHUNKS=document_chunks
CHROMA_COLLECTION_ENTITIES=entity_descriptions

# ---- Ingestion ----
UPLOAD_DIR=uploads
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_UPLOAD_MB=25
