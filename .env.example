# =============================================================================
# GraphRAG Intelligence Platform — Environment Template
# Copy to `.env` and fill in the values you need.
# =============================================================================

# ---- Core ----
ENVIRONMENT=development
# DEMO_MODE=true runs the entire stack with an in-memory seeded graph and a
# deterministic local narrative generator. No Neo4j / OpenAI key required.
DEMO_MODE=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_V1_PREFIX=/api/v1

# ---- Frontend ----
# Leave empty to use the Next.js proxy (/api/* -> http://backend:8000).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_DEMO_MODE=true

# ---- LLM ----
# Providers are tried left to right. The first one that answers wins; a broken
# provider is skipped for 60s instead of being retried for every chunk.
LLM_PROVIDER_ORDER=gemini,ollama,openrouter,openai

# Google Gemini (priority 1) — free tier at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Ollama (priority 2) — local, no key. Start `ollama serve` and pull the model.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# OpenRouter (priority 3) — free models, no credit card.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI (optional last resort)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EXTRACTION_CONCURRENCY=25
LLM_TIMEOUT_SECONDS=90

# ---- Neo4j ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag_dev_password

# ---- PostgreSQL ----
POSTGRES_USER=graphrag
POSTGRES_PASSWORD=graphrag
POSTGRES_DB=graphrag
POSTGRES_DSN=postgresql+asyncpg://graphrag:graphrag@localhost:5432/graphrag

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- ChromaDB ----
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_CHUNKS=document_chunks
CHROMA_COLLECTION_ENTITIES=entity_descriptions

# ---- Ingestion ----
UPLOAD_DIR=uploads
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_UPLOAD_MB=25
# auto = Docling first, PyMuPDF fallback; docling/pymupdf force one parser.
PDF_PARSER=auto

# ---- Graph ----
# true = merge each upload into one evolving graph (Phase B default).
# false = each upload replaces the previous graph.
GRAPH_ACCUMULATE=false
GRAPH_PERSIST=true
